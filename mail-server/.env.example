# Mail server example env
# Use either SENDGRID_API_KEY OR SMTP_* settings

# PORT to run the server on
PORT=3001

# If provided, SendGrid will be used
SENDGRID_API_KEY=

# SMTP fallback (Gmail: smtp.gmail.com, port 587, use app password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# From email used in outgoing messages
FROM_EMAIL="no-reply@yourdomain.com"

# Optionally set APP_URL used to construct links (if frontend expects specific host)
#APP_URL=http://localhost:8100
